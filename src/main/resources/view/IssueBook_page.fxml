<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.IssueBookPageController">
   <children>
      <VBox prefHeight="497.0" prefWidth="202.0" styleClass="sidebar" stylesheets="@../css/style.css">
         <children>
            <Pane prefHeight="61.0" prefWidth="213.0" style="-fx-background-color: #ffffff;">
               <children>
                  <ImageView fitHeight="83.0" fitWidth="82.0" layoutX="7.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../img/book.jpg" />
                     </image>
                  </ImageView>
                  <Label layoutX="89.0" layoutY="21.0" text="BookHaven">
                     <font>
                        <Font name="Georgia Italic" size="18.0" />
                     </font>
                  </Label>
               </children>
            </Pane>
            <Button fx:id="btnNavDashboard" mnemonicParsing="false" onAction="#btnNavDashboardOnAction" prefHeight="30.0" prefWidth="212.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Dashboard ">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnNavAddBook" mnemonicParsing="false" onAction="#btnNavAddBookOnAction" prefHeight="30.0" prefWidth="206.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Add Book ">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnNavAddMember" mnemonicParsing="false" onAction="#btnNavAddMemberOnAction" prefHeight="30.0" prefWidth="211.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Add Member">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnNavManageMembers" mnemonicParsing="false" onAction="#btnNavManageMembersOnAction" prefHeight="30.0" prefWidth="208.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Manage Members">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnNavIssueBook" disable="true" mnemonicParsing="false" onAction="#btnNavIssueBookOnAction" prefHeight="30.0" prefWidth="213.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Issue Book ">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnNavReturnBook" mnemonicParsing="false" onAction="#btnNavReturnBookOnAction" prefHeight="30.0" prefWidth="207.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Return Book">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnNavBorrowingHistory" mnemonicParsing="false" onAction="#btnNavBorrowingHistoryOnAction" prefHeight="30.0" prefWidth="205.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Borrowing History">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnLogOut" mnemonicParsing="false" onAction="#btnLogOutOnAction" prefHeight="47.0" prefWidth="198.0" styleClass="logout-button" stylesheets="@../css/style.css" text="Logout" textFill="#dd1717">
               <font>
                  <Font size="18.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </VBox>
      <Label layoutX="227.0" layoutY="22.0" text="Issue Book " textAlignment="CENTER">
         <font>
            <Font name="Georgia Bold" size="24.0" />
         </font>
      </Label>
      <Pane layoutX="211.0" layoutY="59.0" prefHeight="204.0" prefWidth="460.0" styleClass="stat-card" stylesheets="@../css/style.css">
         <children>
            <Label layoutX="37.0" layoutY="27.0" text="Select Member">
               <font>
                  <Font name="Georgia Italic" size="14.0" />
               </font>
            </Label>
            <Label layoutX="247.0" layoutY="29.0" text="Select Book">
               <font>
                  <Font name="Georgia Italic" size="14.0" />
               </font>
            </Label>
            <ComboBox fx:id="SelecterIssueBook_SelectMemeber" layoutX="35.0" layoutY="52.0" prefHeight="25.0" prefWidth="178.0" />
            <ComboBox fx:id="SelecterIssueBook_SelectBook" layoutX="247.0" layoutY="54.0" prefHeight="25.0" prefWidth="178.0" />
            <DatePicker fx:id="SelecterIssueBook_SelectIssueDate" layoutX="35.0" layoutY="105.0" prefHeight="35.0" prefWidth="178.0" />
            <Label layoutX="42.0" layoutY="87.0" text="Issue Date">
               <font>
                  <Font name="Georgia Italic" size="14.0" />
               </font>
            </Label>
            <DatePicker fx:id="SelecterIssueBook_SelectDueDate" layoutX="247.0" layoutY="105.0" prefHeight="35.0" prefWidth="178.0" />
            <Label layoutX="252.0" layoutY="87.0" text="Due Date">
               <font>
                  <Font name="Georgia Italic" size="14.0" />
               </font>
            </Label>
            <Button fx:id="btnIssueBook" layoutX="33.0" layoutY="160.0" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="30.0" prefWidth="395.0" styleClass="save-button" text="Issue Book" />
         </children>
      </Pane>
      <Pane layoutX="211.0" layoutY="274.0" prefHeight="217.0" prefWidth="583.0" styleClass="stat-card" stylesheets="@../css/style.css">
         <children>
            <TableView layoutX="10.0" layoutY="48.0" prefHeight="150.0" prefWidth="564.0">
               <columns>
                  <TableColumn prefWidth="75.0" text="Issue ID" />
                  <TableColumn prefWidth="110.0" text="Member Name" />
                  <TableColumn prefWidth="130.0" text="Book Title" />
                  <TableColumn prefWidth="84.0" text="Issue Date" />
                  <TableColumn text="Due Date" />
                  <TableColumn prefWidth="85.0" text="Status" />
               </columns>
            </TableView>
            <Label layoutX="13.0" layoutY="14.0" text="Recent Issues">
               <font>
                  <Font name="Georgia Italic" size="18.0" />
               </font>
            </Label>
         </children>
      </Pane>
   </children>
</AnchorPane>
