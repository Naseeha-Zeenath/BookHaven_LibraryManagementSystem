            </Label>
            <TextField fx:id="txtCurrentlyBorrowedBooksCount" editable="false" layoutX="84.0" layoutY="39.0" prefHeight="60.0" prefWidth="95.0" style="-fx-background-color: #FFFFFF; -fx-border-width: 0;" styleClass="stat-value" text="-----">
