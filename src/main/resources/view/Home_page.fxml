                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnLogOut" mnemonicParsing="false" onAction="#btnLogOutOnAction" prefHeight="47.0" prefWidth="198.0" styleClass="logout-button" stylesheets="@../css/style.css" text="Logout" textFill="#dd1717">
