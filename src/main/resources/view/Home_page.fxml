               </font>
               <cursor>
                  <Cursor fx:constant="DEFAULT" />
               </cursor>
            </TextField>
         </children>
      </Pane>
      <VBox prefHeight="403.0" prefWidth="199.0" styleClass="sidebar" stylesheets="@../css/style.css">
         <children>
            <Pane prefHeight="61.0" prefWidth="213.0" style="-fx-background-color: #ffffff;">
               <children>
                  <ImageView fitHeight="83.0" fitWidth="82.0" layoutX="7.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../img/book.jpg" />
                     </image>
                  </ImageView>
                  <Label layoutX="89.0" layoutY="21.0" text="BookHaven">
                     <font>
                        <Font name="Georgia Italic" size="18.0" />
                     </font>
                  </Label>
               </children>
            </Pane>
            <Button fx:id="btnDashboard" disable="true" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="30.0" prefWidth="212.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Dashboard ">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnAddBook" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="30.0" prefWidth="206.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Add Book ">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnAddMember" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="30.0" prefWidth="211.0" styleClass="nav-button" stylesheets="@../css/style.css" text="Add Member">
