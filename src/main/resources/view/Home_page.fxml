                  <Font name="System Bold Italic" size="24.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </TextField>
         </children>
      </Pane>
      <Pane layoutX="210.0" layoutY="218.0" prefHeight="113.0" prefWidth="241.0">
         <children>
            <Button fx:id="currentlyBorrowedBooksViewPanel" mnemonicParsing="false" onAction="#btnCurrentlyBorrowedBooksOnAction" prefHeight="107.0" prefWidth="241.0" styleClass="stat-card">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Label layoutX="14.0" layoutY="14.0" text="Currently Borrowed Books">
               <font>
                  <Font name="Georgia Italic" size="18.0" />
