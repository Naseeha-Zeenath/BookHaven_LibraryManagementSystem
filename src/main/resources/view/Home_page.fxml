            <TextField fx:id="txtOverdueBooksCount" editable="false" layoutX="87.0" layoutY="39.0" prefHeight="60.0" prefWidth="95.0" style="-fx-background-color: #FFFFFF; -fx-border-width: 0;" text="------">
